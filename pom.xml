<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>
    <groupId>com.susswein</groupId>
    <artifactId>owlmask-pdf</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>owlmask-pdf</name>
    <description>Private raster-first PDF redaction service for OwlMask.</description>
    <inceptionYear>2026</inceptionYear>
    <organization><name>Yehoshua Zev Susswein</name></organization>
    <licenses>
        <license>
            <name>Proprietary — All Rights Reserved</name>
            <distribution>manual</distribution>
            <comments>Proprietary and confidential. See the LICENSE file.</comments>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <owlmask-share.version>1.0.0-SNAPSHOT</owlmask-share.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.susswein</groupId>
            <artifactId>owlmask-share-pdf</artifactId>
            <version>${owlmask-share.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
